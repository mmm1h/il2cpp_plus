+
+uint8_t il2cpp::vm::GlobalMetadata::ConvertPackingSizeEnumToValue(PackingSize packingSize)
+{
+    switch (packingSize)
+    {
+    case Zero:
+        return 0;
+    case One:
+        return 1;
+    case Two:
+        return 2;
+    case Four:
+        return 4;
+    case Eight:
+        return 8;
+    case Sixteen:
+        return 16;
+    case ThirtyTwo:
+        return 32;
+    case SixtyFour:
+        return 64;
+    case OneHundredTwentyEight:
+        return 128;
+    default:
+        Assert(0 && "Invalid packing size!");
+        return 0;
+    }
+}
